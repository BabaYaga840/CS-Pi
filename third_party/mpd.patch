+    def _create_bspline_knots(num_control_points, degree):
+        d = degree
+        c = num_control_points
+        m = d + c
+        return np.pad(np.linspace(0., 1., m + 1 - 2 * d), d, 'edge')
+
+    def fit_bspline_to_path(
+            path, bspline_degree, bspline_num_control_points,
+            bspline_zero_vel_at_start_and_goal, bspline_zero_acc_at_start_and_goal,
+            debug=False, **kwargs):
+        knots = _create_bspline_knots(bspline_num_control_points, bspline_degree)
+        tck, u = interpolate.splprep(path.T, k=bspline_degree, t=knots, task=-1, quiet=True)
+        tt, cc, k = tck
+        cc = np.array(cc)
+        if bspline_zero_vel_at_start_and_goal:
+            cc[:, 0] = path[0].copy(); cc[:, -1] = path[-1].copy()
+            cc[:, 1] = cc[:, 0].copy(); cc[:, -2] = cc[:, -1].copy()
+        if bspline_zero_acc_at_start_and_goal:
+            cc[:, 2] = cc[:, 0].copy(); cc[:, -3] = cc[:, -1].copy()
+        tck[1] = cc.copy()
+        return tck
